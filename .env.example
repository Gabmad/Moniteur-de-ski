# Set this in Vercel → Project → Settings → Environment Variables
ADMIN_PASSWORD=change-me

# On Vercel, connect a Blob store to the project (Storage → Blob).
# That adds BLOB_STORE_ID (OIDC auth). Optional legacy: BLOB_READ_WRITE_TOKEN.
# Locally, dates save to data/availability.json without these.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
